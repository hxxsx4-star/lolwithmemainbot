# 디스코드 봇 토큰
DISCORD_TOKEN=

# 라이엇 API 키 (https://developer.riotgames.com 에서 발급)
# 비워두면 /등록 이 실제 계정 확인 없이 진행됩니다.
RIOT_API_KEY=

# 서버 ID — 지정하면 슬래시 명령어가 즉시 반영됩니다. (비우면 전역 등록, 최대 1시간 소요)
GUILD_ID=

# 시간대 (기본: Asia/Seoul)
TIMEZONE=Asia/Seoul

# 라이엇 API 지역 라우팅
RIOT_ACCOUNT_REGION=asia
RIOT_PLATFORM=kr

# 데이터 저장 경로 (기본: ./data)
DATA_DIR=

# 프로필 카드 배경 파일명 (assets/ 안에 두세요)
PROFILE_BACKGROUND=profile_bg.png
